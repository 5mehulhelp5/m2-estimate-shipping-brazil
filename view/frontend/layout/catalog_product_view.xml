<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Not product.info.form.content: form.phtml only prints that container for products without options,
             so the estimate never appeared on configurable and bundle products. -->
        <referenceContainer name="product.info.main">
            <block name="product.info.shipping"
                   as="shipping"
                   class="Magento\Framework\View\Element\Template"
                   template="Fineweb_SimulateProductShipping::product/view/simulate-shipping.phtml"
                   after="product.info">
                <arguments>
                    <argument name="view_model" xsi:type="object">Fineweb\SimulateProductShipping\ViewModel\ShippingForm</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
